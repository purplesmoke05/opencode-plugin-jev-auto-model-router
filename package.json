{
  "name": "opencode-plugin-jev-auto-model-router",
  "version": "0.1.0",
  "description": "An opt-in Auto (Jev) model for OpenCode: route each user turn to your configured model allowlist.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/purplesmoke05/opencode-plugin-jev-auto-model-router.git"
  },
  "bugs": {
    "url": "https://github.com/purplesmoke05/opencode-plugin-jev-auto-model-router/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jev",
    "model-routing"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:e2e": "OPENCODE_E2E=1 bun test tests/e2e.test.ts",
    "demo": "bun run scripts/demo.ts",
    "lint": "biome check .",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.31 <1.19.0"
  },
  "dependencies": {
    "ky": "^1.14.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@opencode-ai/plugin": "1.18.31",
    "@types/bun": "^1.3.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0"
  }
}
